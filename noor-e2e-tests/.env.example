# Copy to .env and fill in. Never commit .env.
AUTH_API_URL=https://core.test.api.noor.uz
DELIVERY_API_URL=https://core.test.api.noor.uz/api/v1

MERCHANT_PHONE=+998XXXXXXXXX
MERCHANT_PASSWORD=

# Change if a real login in DevTools shows a different path
LOGIN_PATH=/api/v1/auth/merchant
LOGOUT_PATH=/api/v1/auth/logout

# Employee tests: adding an employee sends an SMS with a password to this phone — use numbers you control
EMPLOYEE_TEST_PHONE=
EMPLOYEE_TEST_PHONE_2=

# Cashier permission tests: an existing cashier employee and the password from their SMS
CASHIER_PHONE=
CASHIER_PASSWORD=
MANAGER_PHONE=
MANAGER_PASSWORD=

# Noor admin (cpanel) — moderation tests approve/reject with it
ADMIN_PHONE=
ADMIN_PASSWORD=
